# Publieke configuratie; vul echte projectwaarden lokaal in .env.local in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alleen Node.js/Vercel, nooit VITE_-prefix of browseropslag.
# Bestaande serverconfiguratie blijft in Vercel; geen echte waarden committen.
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pas activeren na Redis-healthcheck én Supabase Auth IP-forwarding.
MFA_REPLAY_ENABLED=false
