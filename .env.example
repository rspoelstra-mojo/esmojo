# Publieke configuratie; vul echte projectwaarden lokaal in .env.local in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alleen Node.js/Vercel, nooit VITE_-prefix of browseropslag.
# Bestaande serverconfiguratie blijft in Vercel; geen echte waarden committen.
SUPABASE_SECRET_KEY=
# Productie gebruikt uitsluitend de geverifieerde Dataverse-autoriteit.
REDIS_STORAGE_PROVIDER=dataverse
# Supabase Auth, IP-forwarding en de aanvullende MFA-poort blijven behouden.
MFA_REPLAY_ENABLED=false
