{
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{onderzoeksprompts/**,.agents/skills/esmojo-concertonderzoek/references/catalogue.json}"
    },
    "api/access.js": {
      "includeFiles": "server/report-original/**",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/.well-known/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shows/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/artiest/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/statistieken/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/beheerder/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/activeren/:path*",
      "destination": "/index.html"
    }
  ]
}
