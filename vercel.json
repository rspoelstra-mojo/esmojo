{
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{onderzoeksprompts/**,.agents/skills/esmojo-concertonderzoek/references/catalogue.json}",
      "maxDuration": 300
    },
    "api/access.js": {
      "includeFiles": "{server/report-original/**,server/email/template.html,server/email-templates/**,server/ontrack-report/assets/**}",
      "maxDuration": 300
    },
    "api/ontrack-reports-sync.js": {
      "includeFiles": "{server/report-original/assets/**,server/email/template.html,server/ontrack-report/assets/**}",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/.well-known/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/test/fluid-layout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shows/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/artiest/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/statistieken/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/beheerder/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/activeren/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/test/fluid-layout",
      "destination": "/index.html"
    }
  ]
}
